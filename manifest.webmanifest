{
  "id": "./",
  "name": "Glamor & Grace",
  "short_name": "Glamor & Grace",
  "description": "Feminine lifestyle finds, fashion, beauty and everyday inspiration.",
  "lang": "en-ZA",
  "start_url": "./index.html?source=installed-app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f9edf1",
  "theme_color": "#f3d6df",
  "categories": ["shopping", "lifestyle"],
  "icons": [
    {
      "src": "icons/gg-app-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/gg-app-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop all",
      "short_name": "Shop",
      "url": "./shop.html",
      "icons": [{ "src": "icons/gg-app-icon.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Shopping bag",
      "short_name": "Bag",
      "url": "./cart.html",
      "icons": [{ "src": "icons/gg-app-icon.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
}